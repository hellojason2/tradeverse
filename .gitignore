# Root workspace is detached HEAD - no commits should be made here
# All development happens in app/ or features/*/ directories

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Temporary files
*.tmp
*.temp

# Dependencies & build artifacts
node_modules/
dist/
dist-ssr/
*.local

# Worktrees (linked checkouts — code lives in branches, not root)
/app/
/features/*/
CLAUDE.local.md

# Responsive audit screenshots (generated)
.responsive-audit/

# AI agent session logs (never commit)
.omc/
**/.omc/

# Playwright test artifacts (never commit)
.playwright-mcp/

# Root-level screenshots from test runs (never commit)
/*.png

# Agent tracking files (never commit)
DONE-agent*.md
