generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  passwordHash String @map("password_hash")
  role      UserRole @default(USER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  mtAccounts MtAccount[]
  strategies Strategy[]
  wallets    Wallet[]
  copyRelationsAsFollower CopyRelation[] @relation("FollowerUser")

  @@map("users")
}

enum UserRole {
  USER
  TRADER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model MtAccount {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  broker    String
  accountNumber String @map("account_number")
  password  String   // encrypted orCopyPro token
  server    String
  platform  Platform
  status    AccountStatus @default(PENDING)
  copyProAccountId String? @map("copy_pro_account_id")
  copyProApiId     String? @map("copy_pro_api_id")
  balance   Decimal? @db.Decimal(19, 8)
  equity    Decimal? @db.Decimal(19, 8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user       User    @relation(fields: [userId], references: [id])
  masterStrategies Strategy[] @relation("MasterAccount")
  slaveCopyRelations CopyRelation[] @relation("SlaveAccount")

  @@map("mt_accounts")
}

enum Platform {
  MT4
  MT5
}

enum AccountStatus {
  PENDING
  ACTIVE
  ERROR
  CLOSED
}

model Strategy {
  id        String   @id @default(uuid())
  name      String
  userId    String   @map("user_id")
  masterAccountId String @map("master_account_id")
  description String?
  riskType  RiskType
  riskValue Decimal  @db.Decimal(19, 8)
  followerSplitPct Decimal @map("follower_split_pct") @db.Decimal(5, 4)
  status    StrategyStatus @default(DRAFT)
  minRiskCapital Decimal? @map("min_risk_capital") @db.Decimal(19, 8)
  maxRiskCapital Decimal? @map("max_risk_capital") @db.Decimal(19, 8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id])
  masterAccount MtAccount @relation("MasterAccount", fields: [masterAccountId], references: [id])
  copyRelations CopyRelation[]

  @@map("strategies")
}

enum RiskType {
  FIXED
  PROPORTIONAL
}

enum StrategyStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

model CopyRelation {
  id        String   @id @default(uuid())
  followerUserId String @map("follower_user_id")
  slaveAccountId String @map("slave_account_id")
  strategyId String   @map("strategy_id")
  riskCapital Decimal @map("risk_capital") @db.Decimal(19, 8)
  riskCapitalSnapshot Decimal @map("risk_capital_snapshot") @db.Decimal(19, 8)
  status    CopyStatus @default(PENDING)
  copyProCopierId String? @map("copy_pro_copier_id")
  equityProtectorPct Decimal? @map("equity_protector_pct") @db.Decimal(5, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  followerUser User      @relation("FollowerUser", fields: [followerUserId], references: [id])
  slaveAccount MtAccount @relation("SlaveAccount", fields: [slaveAccountId], references: [id])
  strategy     Strategy  @relation(fields: [strategyId], references: [id])
  trades       Trade[]

  @@map("copy_relations")
}

enum CopyStatus {
  PENDING
  ACTIVE
  PAUSED
  BREACHED
  CLOSED
}

model Trade {
  id        String   @id @default(uuid())
  copyRelationId String @map("copy_relation_id")
  ticket    String
  symbol    String
  type      String
  openPrice Decimal  @map("open_price") @db.Decimal(19, 8)
  closePrice Decimal? @map("close_price") @db.Decimal(19, 8)
  lots      Decimal  @db.Decimal(19, 8)
  profit    Decimal? @db.Decimal(19, 8)
  openTime  DateTime @map("open_time")
  closeTime DateTime? @map("close_time")
  createdAt DateTime @default(now()) @map("created_at")

  copyRelation CopyRelation @relation(fields: [copyRelationId], references: [id])

  @@map("trades")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  currency  String   @default("USDT")
  balance   Decimal  @db.Decimal(19, 8)
  frozen    Decimal  @default(0) @db.Decimal(19, 8)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@map("wallets")
}

model Transaction {
  id        String   @id @default(uuid())
  walletId  String   @map("wallet_id")
  type      TransactionType
  amount    Decimal  @db.Decimal(19, 8)
  fee       Decimal  @default(0) @db.Decimal(19, 8)
  status    TransactionStatus @default(PENDING)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@map("transactions")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  COPY_FEE
  INSURANCE_PREMIUM
  PAYOUT
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}
